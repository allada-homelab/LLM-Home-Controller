{
    "name": "LLM-Home-Controller",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/LLM-Home-Controller,type=bind,consistency=cached",
    "workspaceFolder": "/workspace/LLM-Home-Controller",
    "init": true,
    "waitFor": "postCreateCommand",
    "initializeCommand": ".devcontainer/initialize",
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
        "ghcr.io/devcontainers/features/git:1": {},
        "ghcr.io/devcontainers/features/sshd:1": {},
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.14"
        }
    },
    "mounts": [
        // HOME + USERPROFILE concatenation so the source resolves on Linux/macOS
        // AND Windows (exactly one var is set per OS) — DEVC-012.
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/vscode/.ssh,type=bind,readonly",
        // Host git identity/config, included read-only from ~/.gitconfig.host by
        // postCreateCommand so commits inside the container carry your identity.
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.gitconfig,target=/home/vscode/.gitconfig.host,type=bind,readonly",
        // Claude Code state: per-worktree named volume so login + history survive
        // rebuilds and stay isolated from the host (DEVC-015). Never bind-mount this.
        "source=llmhc-claude-${devcontainerId},target=/home/vscode/.claude,type=volume",
        // uv download cache: shared across worktrees so rebuilds don't re-fetch (DEVC-005).
        "source=llmhc-uv-cache,target=/home/vscode/.cache/uv,type=volume"
    ],
    // Named volumes mount root-owned; hand them to the non-root user once on create (DEVC-010).
    "onCreateCommand": "sudo mkdir -p /home/vscode/.claude /home/vscode/.cache/uv && sudo chown -R vscode:vscode /home/vscode/.claude /home/vscode/.cache",
    "postCreateCommand": "git config --global include.path /home/vscode/.gitconfig.host && git config --global --add safe.directory '*' && uv sync && uv tool install rust-just==1.55.1 && uv run pre-commit install --install-hooks -t pre-commit -t post-checkout -t post-merge",
    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "ms-python.python",
                "charliermarsh.ruff",
                "tamasfe.even-better-toml"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/workspace/LLM-Home-Controller/.venv/bin/python",
                "editor.formatOnSave": true,
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff"
                },
                // Autonomous-agent bypass: intentional for this isolated dev container.
                // Note it pairs with a host Docker socket + mounted SSH keys — keep the container trusted.
                "claude-code.permissions.defaultMode": "bypassPermissions"
            }
        }
    },
    "remoteUser": "vscode"
}
